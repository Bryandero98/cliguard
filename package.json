{
  "name": "cliguard",
  "version": "0.4.0",
  "description": "Snapshot-tests your CLI's contract (commands, flags, defaults) so you never ship a breaking change by accident.",
  "keywords": [
    "cli",
    "contract-testing",
    "snapshot-testing",
    "commander",
    "ci"
  ],
  "author": "Bryandero98",
  "license": "MIT",
  "homepage": "https://github.com/Bryandero98/cliguard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bryandero98/cliguard.git"
  },
  "bugs": {
    "url": "https://github.com/Bryandero98/cliguard/issues"
  },
  "funding": "https://ko-fi.com/bryandero98",
  "bin": {
    "cliguard": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "pretest": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "cac": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "cac": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "cac": "^6.7.14",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
